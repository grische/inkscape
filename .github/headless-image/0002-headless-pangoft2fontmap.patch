diff --git a/src/libnrtype/font-factory.cpp b/src/libnrtype/font-factory.cpp
index 4e5467b54d..c73fecd971 100644
--- a/src/libnrtype/font-factory.cpp
+++ b/src/libnrtype/font-factory.cpp
@@ -221,7 +221,12 @@ FontFactory::FontFactory()
     : fontServer(pango_ft2_font_map_new())
     , fontContext(pango_font_map_create_context(fontServer))
 {
-    _font_map = Glib::wrap(fontServer);
+    // We own the reference returned by pango_ft2_font_map_new() and release it in
+    // the destructor. We intentionally do NOT Glib::wrap() it here: the wrapper is
+    // only needed by get_font_families() (a GUI-only path), and wrapping it eagerly
+    // emits a spurious "Failed to wrap object of type 'PangoFT2FontMap'" warning on
+    // every headless export, because the pangomm type wrappers are not registered
+    // without a display. The wrapper is created lazily in get_font_families().
     pango_ft2_font_map_set_resolution(PANGO_FT2_FONT_MAP(fontServer), 72, 72);
 #if PANGO_VERSION_CHECK(1,48,0)
     pango_fc_font_map_set_default_substitute(PANGO_FC_FONT_MAP(fontServer), FactorySubstituteFunc, this, nullptr);
@@ -234,7 +239,8 @@ FontFactory::~FontFactory()
 {
     loaded.clear();
     g_object_unref(fontContext);
-    fontServer = 0; // freed by _font_map
+    g_object_unref(fontServer); // release the reference from pango_ft2_font_map_new()
+    fontServer = nullptr;
 }
 
 void FontFactory::refreshConfig()
@@ -424,6 +430,11 @@ std::map<std::string, PangoFontFamily *> FontFactory::GetUIFamilies()
 }
 
 std::vector<Glib::RefPtr<Pango::FontFamily>> FontFactory::get_font_families() {
+    if (!_font_map) {
+        // Wrap lazily (see the constructor). take_copy=true keeps our own reference,
+        // independent of the one released in the destructor via fontServer.
+        _font_map = Glib::wrap(fontServer, true);
+    }
     auto list = _font_map->list_families();
     std::vector<Glib::RefPtr<Pango::FontFamily>> sorted;
     sorted.reserve(list.size());
